# CineGenie AI - Backend Environment Variables
# Copy this file to .env and fill in your values

# App
APP_NAME=CineGenie AI
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# SQLite (development default)
DATABASE_URL=sqlite:///./cinegenie.db
# PostgreSQL (production example)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/cinegenie

# OpenAI  <-- ADD YOUR KEY HERE
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000

# ChromaDB (optional - for RAG Knowledge Base)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./chroma_data

# CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=./uploads
