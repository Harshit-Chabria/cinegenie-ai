# ========================
# CineGenie AI - .gitignore
# ========================

# ---- Python / Backend ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
env/
venv/
.venv/
pip-wheel-metadata/

# Databases
*.db
*.sqlite
*.sqlite3

# Uploads & AI data
backend/uploads/
backend/chroma_data/

# Environment variables (NEVER commit these)
.env
.env.*
!.env.example

# ---- Node / Frontend ----
node_modules/
frontend/dist/
frontend/.vite/
.pnp
.pnp.js

# ---- OS & Editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.user
*.swp
*.swo

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
